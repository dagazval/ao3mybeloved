---
interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = "AO3 My Beloved",
  description = "AO3 is dead. Long live AO3.",
  bodyClass = "default",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Anchor Theme CSS files -->
    <link rel="stylesheet" href="/src/styles/reset.css" />
    <link rel="stylesheet" href="/src/styles/theme.css" />
    <link rel="stylesheet" href="/src/styles/small.css" media="(max-width: 400px)" />

    <link rel="shortcut icon" href="images/favicon.png" />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AO3 My Beloved" />
  </head>

  <body class={bodyClass}>
    <div class="main-wrap">
      <!-- Top Navigation & Banner Bar -->
      <header id="top">
        <a id="logo" href="mailto:val@nomikkh.net" title="val@nomikkh.net">nomikkh.net</a>

        <div class="site-banner">
          <a href="/">AO3 My Beloved</a>
        </div>

        <nav id="main" role="navigation">
          <ul>
            <li>
              <a href="/chapters" title="Chapter List">Chapter List</a>
            </li>
          </ul>
        </nav>
      </header>

      <!-- Main Content Slot (Renders your cover_page.md or article content) -->
      <section class="content wrap">
        <slot />
      </section>

      <!-- Bottom Footer -->
      <div class="wrap">
        <footer id="bottom">
          <small>&copy; {new Date().getFullYear()} nomikkh.net. All rights reserved.</small>

          <ul role="navigation">
            <li><a href="https://nomikkh.net" title="Return to main site">nomikkh.net</a></li>
            <li><a href="/" title="Return to home">Home</a></li>
          </ul>
        </footer>
      </div>
    </div>
  </body>
</html>