---
interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = "ao3mybeloved.nomikkh.net",
  description = "AO3 is dead, long live AO3",
  bodyClass = "default",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Anchor Theme CSS files -->
    <link rel="stylesheet" href="../styles/reset.css" />
    <link rel="stylesheet" href="../styles/theme.css" />
    <link rel="stylesheet" href="../styles/small.css" media="(max-width: 400px)" />

    <link rel="shortcut icon" href="/img/favicon.png" />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="nomikkh.net" />
  </head>

  <body class={bodyClass}>
    <div class="main-wrap">
      <!-- Search / Categories Slidey Tray (from Anchor header) -->
      <div class="slidey" id="tray">
        <div class="wrap">
          <form id="search" action="/search" method="get">
            <label for="term">Search my blog:</label>
            <input
              type="search"
              id="term"
              name="term"
              placeholder="To search, type and hit enter&hellip;"
            />
          </form>

          <aside>
            <b>Categories</b>
            <ul>
              <li><a href="../posts">Chapter List</a></li>
            </ul>
          </aside>
        </div>
      </div>

      <!-- Top Header & Navigation -->
      <header id="top">
        <a id="logo" href="/">nomikkh.net</a>

        <nav id="main" role="navigation">
          <ul>
            <li>
              <a href="/" title="Home">Home</a>
            </li>
            <li>
              <a href="/articles" title="Articles">Articles</a>
            </li>
            <li class="tray">
              <a href="#tray" class="linky"
                ><img
                  src="/images/categories.png"
                  alt="Categories"
                  title="View my posts by category"
                /></a
              >
            </li>
          </ul>
        </nav>
      </header>

      <!-- Main Content Slot (Renders your .md or page markup) -->
      <section class="content wrap">
        <slot />
      </section>

      <!-- Bottom Footer -->
      <div class="wrap">
        <footer id="bottom">
          <small>&copy; {new Date().getFullYear()} nomikkh.net. All rights reserved.</small>

          <ul role="navigation">
            <li><a href="/rss.xml">RSS</a></li>
            <li><a href="/" title="Return to website">Home</a></li>
          </ul>
        </footer>
      </div>
    </div>
  </body>
</html>