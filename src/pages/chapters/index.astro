---
import Layout from '../../layouts/Layout.astro';

// 1. Query all local markdown chapters with eager loading
const chapterFiles = import.meta.glob('./*.md', { eager: true });
const allChapters = Object.values(chapterFiles) as any[];

// 2. Sort by chapterNumber ascending (or by date)
const chapters = allChapters.sort((a, b) => {
  const numA = a.frontmatter.chapterNumber || 0;
  const numB = b.frontmatter.chapterNumber || 0;
  return numA - numB;
});
---

<Layout title="Chapter List — AO3 My Beloved" description="All chapters and logs.">
  <section class="chapter-index">
    <h1>Chapter List</h1>

    <ul class="items">
      {chapters.map((chapter) => (
        <li>
          <h2>
            <a href={chapter.url}>{chapter.frontmatter.title}</a>
          </h2>
          {chapter.frontmatter.date && (
            <span class="footnote">{chapter.frontmatter.date}</span>
          )}
        </li>
      ))}
    </ul>
  </section>
</Layout>