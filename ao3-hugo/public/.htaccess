# 1. Look for index.html when directories are requested
DirectoryIndex index.html index.htm

# 2. Rewrite engine rules protected by module wrapper
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve physical files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>